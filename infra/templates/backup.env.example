# Copie para ~/.config/amtech/backup.env. Nenhuma senha aqui: só o caminho do arquivo de senha (chmod 600).
RESTIC_REPOSITORY=/mnt/d/backup-restic
RESTIC_PASSWORD_FILE=$HOME/.config/amtech/restic.senha
BACKUP_PASTAS="$HOME/dev $HOME/AMtech $HOME/.config/amtech $HOME/financas"
# Cópia no HD externo (just backup-externo): o caminho do repositório no HD, com a letra que o Windows deu a ele (E: vira /mnt/e).
# Mesma senha do RESTIC_PASSWORD_FILE. Nunca /mnt/c: é o mesmo SSD.
RESTIC_REPOSITORY_EXTERNO=
