#!/usr/bin/env bash
# Hook de pre-push: roda o `just check` e BLOQUEIA o push se ele falhar.
# Ligue uma vez: git config core.hooksPath scripts/git-hooks   (o just validar confere)
# Push que só envia tags ou só apaga branches não traz código novo: passa sem o check.
# A tag da versão é criada depois do merge, no commit do merge (CLAUDE.md, seção Git), não aqui.
set -euo pipefail
raiz="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
precisa=0
while read -r ref_local sha_local _ref_remota _sha_remoto; do
  [[ "$sha_local" == "$zero" ]] && continue          # apagando branch no remoto
  [[ "$ref_local" == refs/tags/* ]] && continue      # só tag
  precisa=1
done
((precisa)) || exit 0
command -v just >/dev/null 2>&1 || { echo "pre-push: 'just' não encontrado; instale com bash scripts/wsl/bootstrap.sh" >&2; exit 1; }
echo "pre-push: rodando just check (bloqueia o push se falhar)..." >&2
if ! (cd "$raiz" && just check >/tmp/pre-push-check.log 2>&1); then
  echo "pre-push: just check FALHOU; push bloqueado. Últimas linhas:" >&2
  tail -15 /tmp/pre-push-check.log >&2
  exit 1
fi
echo "pre-push: just check verde." >&2
